# Copy to `.env` — docker compose reads it automatically.

# Which Ollama model to pull on first start.
# MUST match `ai.model` in sentinelready.yaml. Compose cannot read that
# file, so the model name is repeated here; a mismatch means the model you
# configured is never downloaded and the first alert falls back to a raw
# (unenriched) alert after the AI call times out.
SENTINEL_MODEL=llama3.1
